{
  "name": "@go-board/tooling",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build": "run-s tool:build ui:build design:build",
    "release": "gulp release -f common/release.ts",
    "design:release": "gulp release -f design/index.ts",
    "design:build": "gulp build -f design/index.ts",
    "design:publish": "gulp publish -f design/index.ts",
    "ui:release": "gulp release -f ui/index.ts",
    "ui:build": "gulp build -f ui/index.ts",
    "ui:publish": "gulp publish -f ui/index.ts",
    "tool:release": "gulp release -f tool/index.ts",
    "tool:build": "gulp build -f tool/index.ts",
    "tool:publish": "gulp publish -f tool/index.ts"
  },
  "devDependencies": {
    "@types/gulp": "^4.0.18",
    "bumpp": "^12.2.1",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "npm-run-all2": "^9.0.3",
    "sucrase": "^3.35.1",
    "tsdown": "^0.22.14"
  }
}
